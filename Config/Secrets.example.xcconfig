// Copy to Config/Secrets.xcconfig and fill in. That file is git-ignored.

// A bundle ID you own, e.g. com.yourname.healthsync
APP_BUNDLE_ID = com.yourname.healthsync

// Your Apple Developer Team ID (Xcode → Settings → Accounts, or developer.apple.com → Membership)
APP_DEVELOPMENT_TEAM = ABCDE12345

// From Google Cloud Console → APIs & Services → Credentials → your iOS OAuth client
GOOGLE_CLIENT_ID = 1234567890-abcdefg.apps.googleusercontent.com
// The "iOS URL scheme" shown on the same page (the client ID reversed)
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.1234567890-abcdefg
